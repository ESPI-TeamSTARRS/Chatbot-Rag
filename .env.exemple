# Copy this file to .env and adjust the values (docker compose reads .env automatically).

# Print [DEBUG] logs (LLM calls, tool calls and results) on stdout.
DEBUG=true

# Documentation folder, indexed by the MCP search server.
# Docker: path of the folder on your machine, mounted at /app/documentations in the container.
# Without Docker: the folder read directly (default: ./documentations).
DOCS_PATH=./documentations

# BM25 search MCP server (../mcp-server). docker-compose-dev.yml runs the app on the host network: localhost works.
# deploy/docker-compose.prod.yml defaults to http://host.docker.internal:8001/mcp (a localhost value there is the container itself).
# SEARCH_MCP_URL=http://localhost:8001/mcp

# Loki receiving the history. docker-compose-dev.yml (host network) defaults to its own Loki on localhost:3100;
# deploy/docker-compose.prod.yml needs an existing Loki (set it here); a localhost value breaks that container.
# LOKI_URL=http://localhost:3100

# n8n webhook receiving the error log and the procedure to follow (JSON: error_log, procedure).
N8N_WEBHOOK_URL=http://<n8n-host>:5678/webhook/<path>
N8N_TOKEN=<token>
# OpenAI-compatible endpoint (Ollama runs on another machine).
LLM_BASE_URL=http://<ollama-host>:11434/v1

# Model name served by Ollama; it must support tool calling.
LLM_MODEL=<model-name>

RECIPIENT_EMAIL=example@example.com
