# Copy this file to .env and adjust the values (docker compose reads .env automatically).

# Print [DEBUG] logs (LLM calls, tool calls and results) on stdout.
DEBUG=true

# Documentation folder indexed by BM25 (actions-taken/ is excluded).
# Docker: path of the folder on your machine, mounted at /app/documentations in the container.
# Without Docker: the folder read directly (default: ./documentations).
DOCS_PATH=./documentations

# OpenAI-compatible endpoint (Ollama runs on another machine).
LLM_BASE_URL=http://<ollama-host>:11434/v1

# Model name served by Ollama; it must support tool calling.
LLM_MODEL=<model-name>
