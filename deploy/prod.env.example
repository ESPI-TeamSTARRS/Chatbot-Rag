# Modele du fichier .env.prod du serveur (hors depot, ignore par git, droits 600).
# Ne JAMAIS commiter la version remplie.
#
# La reference de l'image (APP_IMAGE) ne se saisit pas ici : ./deploy.sh la lit dans
# deploy/manifest.json, sous la forme ghcr.io/espi-teamstarrs/chatbot-rag@sha256:<digest>.

DEBUG=false

# Dossier de documentation monte en lecture seule dans le conteneur (/app/documentations).
DOCS_PATH=./documentations

# Serveur MCP de recherche BM25 (publie sur l'hote par un autre projet compose ; reseau hote).
SEARCH_MCP_URL=http://localhost:8001/mcp

# Loki existant qui recoit l'historique. L'API refuse de demarrer (code 3) s'il est injoignable.
LOKI_URL=http://<loki-host>:3100

# Endpoint compatible OpenAI (Ollama) et modele servi ; il doit gerer le tool calling.
LLM_BASE_URL=http://<ollama-host>:11434/v1
LLM_MODEL=<model-name>

# Webhook n8n recevant le journal d'erreur et la procedure a suivre.
# L'API refuse de demarrer (code 4) si l'hote est injoignable.
N8N_WEBHOOK_URL=http://<n8n-host>:5678/webhook/<path>
